# AI Project Team Formation System - Environment Configuration
# Copy this file to .env and adjust values if needed.

# Application Settings
APP_ENV=development
APP_SECRET=local-dev-secret-key-change-in-production
DATABASE_URL=sqlite:///data/team_formation.db

# Optional: Google Gemini API Key for enhanced LLM skill & requirement extraction
# Leave empty to use built-in local deterministic NLP & ontology heuristics
GEMINI_API_KEY=

# Default Scoring Weights (Sum to 1.0)
WEIGHT_SKILL_COVERAGE=0.30
WEIGHT_SKILL_COMPLEMENTARITY=0.20
WEIGHT_PROJECT_PREFERENCE=0.15
WEIGHT_AVAILABILITY=0.15
WEIGHT_WORK_STYLE=0.10
WEIGHT_EXPERIENCE_BALANCE=0.10
